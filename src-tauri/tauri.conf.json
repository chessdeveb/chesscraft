{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chesscraft",
  "version": "1.2.0",
  "identifier": "com.houbr.chesscraft",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "chesscraft",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "ChessCraft",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/chessdeveb/chesscraft/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwMUUyQkUxMUQ1QTNBM0IKUldRN09sb2Q0U3NlME9vbVJ6clNlV1U2enNTN3JmOWthbWFWbnR4R1FxZ0pMbHVseGpzd3NMOEgK"
    }
  }
}
