{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the game/game-picker/bases-paths sub-windows",
  "windows": ["main", "game", "game-picker", "bases-paths"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-create",
    "core:window:allow-set-focus",
    "core:window:allow-close"
  ]
}
